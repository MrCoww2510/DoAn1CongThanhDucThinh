Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Nếu URL trỏ tới file/thư mục có thật trong public thì Apache phục vụ trực tiếp.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Các URL còn lại được chuyển tới Front Controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>
