@startuml
title Đăng ký tài khoản
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
actor Khach as U
boundary "register view" as V
control Router as R
control AuthController as C
entity Account as M
database MySQL as DB
U -> V: nhập thông tin, gửi POST /register
V -> R: request + CSRF
R -> C: register()
C -> C: kiểm tra CSRF và dữ liệu
alt dữ liệu không hợp lệ
 C --> V: hiển thị lỗi form
else dữ liệu hợp lệ
 C -> M: usernameExists / emailExists
 M -> DB: SELECT kiểm tra trùng
 DB --> M: kết quả
 alt đã tồn tại
  M --> C: exists
  C --> V: báo trùng
 else chưa tồn tại
  C -> M: register(..., password)
  M -> M: password_hash
  M -> DB: transaction: INSERT NguoiDung, TaiKhoan
  DB --> M: commit
  M --> C: hoàn tất
  C --> U: redirect login
 end
end
@enduml
