@startuml
title Đặt hàng và giữ tồn
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
actor KhachHang as U
boundary "checkout view" as V
control Router as R
control CheckoutController as C
entity Cart as CartM
entity Account as AccountM
entity DeliveryAddress as AddressM
entity Promotion as PromoM
entity Order as OrderM
participant "SePayPayment" as Pay
database MySQL as DB
U -> V: xác nhận checkout
V -> R: POST /checkout + CSRF
R -> C: placeOrder()
C -> C: yêu cầu customer, validate name/phone/payment
C -> AccountM: findCustomerProfile
C -> AddressM: resolve address thuộc customer
C -> CartM: findItems(customerId)
alt dữ liệu hoặc giỏ không hợp lệ
 C --> V: render lỗi checkout
else hợp lệ
 C -> Pay: isConfigured (nếu Online)
 C -> OrderM: placeOrder(customer, recipient, address, method, voucher)
 OrderM -> DB: BEGIN; lock cart / products
 OrderM -> DB: tính lại giá, kiểm tồn, khóa/kiểm voucher
 alt tồn/voucher không hợp lệ
  DB --> OrderM: lỗi
  OrderM --> C: RuntimeException
  C --> V: render lỗi checkout
 else đủ điều kiện
  OrderM -> DB: INSERT DonHang + ChiTietDonHang
  OrderM -> DB: giảm tồn + INSERT LichSuKho
  OrderM -> DB: ghi VoucherSuDung (nếu áp dụng), clear cart, COMMIT
  OrderM --> C: order
  alt Online
   C --> U: redirect /payments/sepay/start
  else COD
   C --> U: redirect /checkout/success
  end
 end
end
note over OrderM,DB: Các bước giao dịch nêu theo Order::placeOrder; tồn bị trừ trong transaction đặt hàng.
@enduml
