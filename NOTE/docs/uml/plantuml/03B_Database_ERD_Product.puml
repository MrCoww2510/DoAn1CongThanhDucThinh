@startuml
title T&T COMPUTER - ERD sản phẩm / danh mục / khuyến mãi / kho
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
entity DanhMuc { *MaDM : VARCHAR(20) <<PK>>\nTenDM : VARCHAR(100) <<UQ>>\nTrangThai : VARCHAR(30) }
entity SanPham { *MaSP : VARCHAR(20) <<PK>>\nMaDM : VARCHAR(20) <<FK>>\nTenSP : VARCHAR(200)\nGiaBan : DECIMAL(18,2)\nSoLuongTon : INT }
entity ChiTietSanPham { *MaCTSP : VARCHAR(20) <<PK>>\nMaSP : VARCHAR(20) <<FK, UQ>>\nLoaiSP : VARCHAR(100) <<NULL>>\nThongSoKT : TEXT <<NULL>>\nThuongHieu : VARCHAR(100) <<NULL>>\nHinhAnh : VARCHAR(500) <<NULL>>\nMoTa : TEXT <<NULL>>\nTrangThai : VARCHAR(50) <<NULL>> }
entity ChuongTrinhGiamGia { *MaCTGG : VARCHAR(20) <<PK>>\nPhamVi : VARCHAR(20)\nLoaiGiam : VARCHAR(20)\nGiaTri : DECIMAL(18,2)\nNgayBatDau : DATETIME\nNgayKetThuc : DATETIME\nTrangThai : VARCHAR(20) }
entity ChuongTrinhGiamGiaSanPham { *MaCTGG : VARCHAR(20) <<PK, FK>>\n*MaSP : VARCHAR(20) <<PK, FK>> }
entity LichSuKho { *MaLS : VARCHAR(20) <<PK>>\nMaSP : VARCHAR(20) <<FK>>\nSoLuongThayDoi : INT\nLoaiThaoTac : VARCHAR(30)\nMaND : VARCHAR(20) <<FK>>\nThoiGian : DATETIME }
entity NguoiDung { *MaND : VARCHAR(20) <<PK>> }
DanhMuc ||--o{ SanPham
SanPham ||--o| ChiTietSanPham
ChuongTrinhGiamGia ||--o{ ChuongTrinhGiamGiaSanPham
SanPham ||--o{ ChuongTrinhGiamGiaSanPham
SanPham ||--o{ LichSuKho
NguoiDung ||--o{ LichSuKho
@enduml
