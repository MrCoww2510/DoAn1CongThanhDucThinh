@startuml
title T&T COMPUTER - Sơ đồ quan hệ cơ sở dữ liệu
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial

package "Nguoi dung va gio hang" {
  entity NguoiDung {
    *MaND : VARCHAR(20) <<PK>>
    --
    HoTen : VARCHAR(100)
    SDT : VARCHAR(15) <<NULL>>
    Email : VARCHAR(100) <<NULL>>
    DiaChiNhanHang : VARCHAR(255) <<NULL>>
  }

  entity TaiKhoan {
    *MaTK : VARCHAR(20) <<PK>>
    --
    MaND : VARCHAR(20) <<FK, UQ>>
    TenDangNhap : VARCHAR(50) <<UQ>>
    MatKhau : VARCHAR(255)
    VaiTro : VARCHAR(20)
    TrangThai : VARCHAR(30)
    GoogleID : VARCHAR(255) <<NULL, UQ>>
  }

  entity DiaChiNhanHang {
    *MaDiaChi : INT UNSIGNED <<PK, AI>>
    --
    MaND : VARCHAR(20) <<FK>>
    DiaChi : VARCHAR(255)
  }

  entity GioHang {
    *MaGH : VARCHAR(20) <<PK>>
    --
    MaND : VARCHAR(20) <<FK, UQ>>
    TongTien : DECIMAL(18,2)
  }

  entity ChiTietGioHang {
    *MaCTGH : VARCHAR(20) <<PK>>
    --
    MaGH : VARCHAR(20) <<FK>>
    MaSP : VARCHAR(20) <<FK>>
    SoLuong : INT
  }
}

package "San pham, khuyen mai va kho" {
  entity DanhMuc {
    *MaDM : VARCHAR(20) <<PK>>
    --
    TenDM : VARCHAR(100) <<UQ>>
    TrangThai : VARCHAR(30)
  }

  entity SanPham {
    *MaSP : VARCHAR(20) <<PK>>
    --
    MaDM : VARCHAR(20) <<FK>>
    TenSP : VARCHAR(200)
    GiaBan : DECIMAL(18,2)
    SoLuongTon : INT
  }

  entity ChiTietSanPham {
    *MaCTSP : VARCHAR(20) <<PK>>
    --
    MaSP : VARCHAR(20) <<FK, UQ>>
    LoaiSP : VARCHAR(100) <<NULL>>
    ThongSoKT : TEXT <<NULL>>
    ThuongHieu : VARCHAR(100) <<NULL>>
    HinhAnh : VARCHAR(500) <<NULL>>
    MoTa : TEXT <<NULL>>
    TrangThai : VARCHAR(50) <<NULL>>
  }

  entity ChuongTrinhGiamGia {
    *MaCTGG : VARCHAR(20) <<PK>>
    --
    TenCTGG : VARCHAR(100)
    PhamVi : VARCHAR(20)
    LoaiGiam : VARCHAR(20)
    GiaTri : DECIMAL(18,2)
    NgayBatDau : DATETIME
    NgayKetThuc : DATETIME
    TrangThai : VARCHAR(20)
  }

  entity ChuongTrinhGiamGiaSanPham {
    *MaCTGG : VARCHAR(20) <<PK, FK>>
    *MaSP : VARCHAR(20) <<PK, FK>>
  }

  entity LichSuKho {
    *MaLS : VARCHAR(20) <<PK>>
    --
    MaSP : VARCHAR(20) <<FK>>
    SoLuongThayDoi : INT
    LoaiThaoTac : VARCHAR(30)
    MaND : VARCHAR(20) <<FK>>
    ThoiGian : DATETIME
  }
}

package "Don hang va thanh toan" {
  entity DonHang {
    *MaDH : VARCHAR(20) <<PK>>
    --
    MaND : VARCHAR(20) <<FK>>
    MaNV : VARCHAR(20) <<FK, NULL>>
    TenNguoiNhan : VARCHAR(100)
    DiaChiGiao : VARCHAR(255)
    SDTNhan : VARCHAR(15)
    TongTien : DECIMAL(18,2)
    PhuongThucTT : VARCHAR(20)
    TrangThaiDH : VARCHAR(50)
    TrangThaiTT : VARCHAR(50)
    MaVoucherCode : VARCHAR(50) <<NULL, no FK>>
    GiamGiaVoucher : DECIMAL(18,2)
    DaHoanKho : TINYINT(1)
    NgayTao : DATETIME
  }

  entity ChiTietDonHang {
    *MaCTDH : VARCHAR(20) <<PK>>
    --
    MaDH : VARCHAR(20) <<FK>>
    MaSP : VARCHAR(20) <<FK>>
    SoLuong : INT
    DonGia : DECIMAL(18,2)
  }

  entity GiaoDichThanhToan {
    *MaGD : VARCHAR(50) <<PK>>
    --
    MaDH : VARCHAR(20) <<FK>>
    MaGatewayTxn : VARCHAR(100) <<NULL, UQ>>
    SoTien : DECIMAL(18,2)
    TrangThai : VARCHAR(30)
    ThoiGianGiaoDich : DATETIME <<NULL>>
  }
}

package "Mã giảm giá" {
  entity Voucher {
    *MaVoucher : VARCHAR(20) <<PK>>
    --
    MaCode : VARCHAR(50) <<UQ>>
    LoaiGiam : VARCHAR(20)
    GiaTri : DECIMAL(18,2)
    NgayBatDau : DATETIME
    NgayKetThuc : DATETIME
    DonToiThieu : DECIMAL(18,2)
    GiamToiDa : DECIMAL(18,2) <<NULL>>
    TongLuotToiDa : INT UNSIGNED <<NULL>>
    LuotMoiKhachToiDa : INT UNSIGNED <<NULL>>
    TrangThai : VARCHAR(20)
  }

  entity VoucherSuDung {
    *MaSuDung : VARCHAR(40) <<PK>>
    --
    MaVoucher : VARCHAR(20) <<FK>>
    MaDH : VARCHAR(20) <<FK, UQ>>
    MaND : VARCHAR(20) <<FK>>
    SoTienGiam : DECIMAL(18,2)
    ThoiGian : DATETIME
  }
}

NguoiDung ||--o| TaiKhoan : tai khoan
NguoiDung ||--o{ DiaChiNhanHang : dia chi
NguoiDung ||--o| GioHang : gio hang
GioHang ||--o{ ChiTietGioHang
SanPham ||--o{ ChiTietGioHang

DanhMuc ||--o{ SanPham
SanPham ||--o| ChiTietSanPham
ChuongTrinhGiamGia ||--o{ ChuongTrinhGiamGiaSanPham
SanPham ||--o{ ChuongTrinhGiamGiaSanPham
SanPham ||--o{ LichSuKho
NguoiDung ||--o{ LichSuKho : nguoi thao tac

NguoiDung ||--o{ DonHang : khach hang
NguoiDung |o--o{ DonHang : nhan vien xu ly
DonHang ||--o{ ChiTietDonHang
SanPham ||--o{ ChiTietDonHang
DonHang ||--o{ GiaoDichThanhToan

Voucher ||--o{ VoucherSuDung
DonHang ||--o| VoucherSuDung
NguoiDung ||--o{ VoucherSuDung

@enduml
