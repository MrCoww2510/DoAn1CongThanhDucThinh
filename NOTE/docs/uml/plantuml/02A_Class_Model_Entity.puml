@startuml
title T&T COMPUTER - Model và dữ liệu nghiệp vụ
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
class Account {
 +findForLogin(identity): ?array
 +register(name, username, email, phone, password): void
 +registerGoogle(googleId, name, email): array
 +findCustomerProfile(userId, role): ?array
 +updateCustomerProfile(...): void
 +createStaff(...): void
 +changeStatus(accountId, status): string
}
class Product {
 +searchCatalog(filters, page, perPage): array
 +findById(id): ?array
 +saveManaged(data, id): string
 +changeProductStatus(id, status): bool
 +saveCategory(name, id): void
}
class Cart {
 -db: PDO
 +getOrCreateCart(userId): string
 +getItems(userId): array
 +addItem(userId, productId, quantity): void
 +updateItem(userId, productId, quantity): void
 +removeItem(userId, productId): void
 +clear(userId): void
}
class Order {
 -db: PDO
 +placeOrder(...): array
 +markOnlineOrderPaid(...): bool
 +findForCustomer(orderId, customerId): ?array
 +updateStatusForManagement(...): void
 +confirmReturnForManagement(...): void
 +cancelForCustomer(orderId, customerId): void
}
class Inventory {
 +products(): array
 +history(): array
 +update(productId, operation, quantity, userId): void
}
class DeliveryAddress {
 +findForCustomer(customerId): array
 +addForCustomer(customerId, address): int
 +updateForCustomer(addressId, customerId, address): bool
 +deleteForCustomer(addressId, customerId): bool
}
class Promotion {
 +applyEffectivePrices(items): array
 +previewVoucher(code, customerId, subtotal): array
 +saveCampaign(data, id): void
 +saveVoucher(data, id): void
}
class Statistics {
 +forPeriod(start, end): array
}
note bottom: Model truy vấn PDO và thường trả array; không có Entity class riêng.
@enduml
