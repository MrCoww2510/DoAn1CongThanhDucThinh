@startuml
title T&T COMPUTER - ERD tổng quát (schema + migrations)
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
hide methods
entity NguoiDung { *MaND : VARCHAR(20) <<PK>> }
entity TaiKhoan { *MaTK : VARCHAR(20) <<PK>>\nMaND : VARCHAR(20) <<FK, UQ>>\nTenDangNhap : VARCHAR(50) <<UQ>>\nGoogleID : VARCHAR(255) <<UQ, NULL>> }
entity DiaChiNhanHang { *MaDiaChi : INT <<PK>>\nMaND : VARCHAR(20) <<FK>>\nDiaChi : VARCHAR(255) <<UQ theo MaND>> }
entity DanhMuc { *MaDM : VARCHAR(20) <<PK>>\nTenDM : VARCHAR(100) <<UQ>> }
entity SanPham { *MaSP : VARCHAR(20) <<PK>>\nMaDM : VARCHAR(20) <<FK>>\nTenSP : VARCHAR(200)\nGiaBan : DECIMAL(18,2)\nSoLuongTon : INT }
entity ChiTietSanPham { *MaCTSP : VARCHAR(20) <<PK>>\nMaSP : VARCHAR(20) <<FK, UQ>>\nThongSoKT : TEXT\nThuongHieu : VARCHAR(100)\nHinhAnh : VARCHAR(500) }
entity GioHang { *MaGH : VARCHAR(20) <<PK>>\nMaND : VARCHAR(20) <<FK, UQ>>\nTongTien : DECIMAL(18,2) }
entity ChiTietGioHang { *MaCTGH : VARCHAR(20) <<PK>>\nMaGH : VARCHAR(20) <<FK>>\nMaSP : VARCHAR(20) <<FK>>\nSoLuong : INT <<UQ(MaGH,MaSP)>> }
entity DonHang { *MaDH : VARCHAR(20) <<PK>>\nMaND : VARCHAR(20) <<FK>>\nMaNV : VARCHAR(20) <<FK, NULL>>\nTongTien : DECIMAL(18,2)\nTrangThaiDH : VARCHAR(50)\nTrangThaiTT : VARCHAR(50)\nMaVoucherCode : VARCHAR(50) <<NULL>>\nGiamGiaVoucher : DECIMAL(18,2)\nDaHoanKho : TINYINT(1) }
entity ChiTietDonHang { *MaCTDH : VARCHAR(20) <<PK>>\nMaDH : VARCHAR(20) <<FK>>\nMaSP : VARCHAR(20) <<FK>>\nSoLuong : INT\nDonGia : DECIMAL(18,2) }
entity GiaoDichThanhToan { *MaGD : VARCHAR(50) <<PK>>\nMaDH : VARCHAR(20) <<FK>>\nMaGatewayTxn : VARCHAR(100) <<UQ, NULL>>\nSoTien : DECIMAL(18,2)\nTrangThai : VARCHAR(30) }
entity LichSuKho { *MaLS : VARCHAR(20) <<PK>>\nMaSP : VARCHAR(20) <<FK>>\nMaND : VARCHAR(20) <<FK>>\nSoLuongThayDoi : INT }
entity ChuongTrinhGiamGia { *MaCTGG : VARCHAR(20) <<PK>>\nTenCTGG : VARCHAR(100)\nPhamVi : VARCHAR(20)\nLoaiGiam : VARCHAR(20)\nGiaTri : DECIMAL(18,2) }
entity ChuongTrinhGiamGiaSanPham { *MaCTGG : VARCHAR(20) <<PK, FK>>\n*MaSP : VARCHAR(20) <<PK, FK>> }
entity Voucher { *MaVoucher : VARCHAR(20) <<PK>>\nMaCode : VARCHAR(50) <<UQ>>\nLoaiGiam : VARCHAR(20)\nGiaTri : DECIMAL(18,2) }
entity VoucherSuDung { *MaSuDung : VARCHAR(40) <<PK>>\nMaVoucher : VARCHAR(20) <<FK>>\nMaDH : VARCHAR(20) <<FK, UQ>>\nMaND : VARCHAR(20) <<FK>> }
NguoiDung ||--o| TaiKhoan
NguoiDung ||--o{ DiaChiNhanHang
NguoiDung ||--o| GioHang
NguoiDung ||--o{ DonHang : buyer
NguoiDung o|--o{ DonHang : staff FK MaNV
NguoiDung ||--o{ LichSuKho
DanhMuc ||--o{ SanPham
SanPham ||--o| ChiTietSanPham
GioHang ||--o{ ChiTietGioHang
SanPham ||--o{ ChiTietGioHang
DonHang ||--o{ ChiTietDonHang
SanPham ||--o{ ChiTietDonHang
DonHang ||--o{ GiaoDichThanhToan
SanPham ||--o{ LichSuKho
ChuongTrinhGiamGia ||--o{ ChuongTrinhGiamGiaSanPham
SanPham ||--o{ ChuongTrinhGiamGiaSanPham
Voucher ||--o{ VoucherSuDung
DonHang ||--o| VoucherSuDung
NguoiDung ||--o{ VoucherSuDung
note bottom: ERD theo FK khai báo. MaVoucherCode trong DonHang không có FK; MaNV FK trỏ NguoiDung, không TaiKhoan.
@enduml
