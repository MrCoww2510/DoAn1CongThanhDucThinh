@startuml
title Quản lý danh mục
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
hide footbox

actor "Quản trị viên" as Admin
boundary "categories page" as CategoriesPage
participant Router
control CatalogManagementController
entity Product
database MySQL as DB

Admin -> CategoriesPage: Mở chức năng quản lý danh mục
CategoriesPage -> Router: GET /admin/categories
Router -> CatalogManagementController: categories()
CatalogManagementController -> Product: categoriesForManagement()
Product -> DB: SELECT danh mục và số sản phẩm liên kết
DB --> Product: Danh sách danh mục
Product --> CatalogManagementController: categories
CatalogManagementController --> CategoriesPage: Hiển thị danh sách, CSRF
CategoriesPage --> Admin: Danh mục, trạng thái và thao tác

opt Thêm hoặc sửa tên danh mục
    Admin -> CategoriesPage: Nhập tên / sửa tên danh mục
    CategoriesPage -> Router: POST /admin/categories/save
    Router -> CatalogManagementController: saveCategory()
    CatalogManagementController -> CatalogManagementController: Kiểm tra CSRF,\ntên bắt buộc và tối đa 100 ký tự
    alt CSRF hoặc tên không hợp lệ
        CatalogManagementController --> CategoriesPage: Flash lỗi, redirect /admin/products
    else Dữ liệu hợp lệ
        CatalogManagementController -> Product: saveCategory(name, MaDM?)
        alt Thêm mới
            Product -> DB: Tạo MaDM mới; INSERT danh mục\nvới trạng thái Đang kinh doanh
        else Cập nhật tên
            Product -> DB: UPDATE TenDM theo MaDM
        end
        DB --> Product: Thành công / lỗi trùng tên hoặc không tồn tại
        alt Lưu thành công
            Product --> CatalogManagementController: Thành công
            CatalogManagementController --> CategoriesPage: Flash thành công,\nredirect /admin/categories
        else Lưu thất bại
            Product --> CatalogManagementController: Exception
            CatalogManagementController --> CategoriesPage: Flash lỗi,\nredirect /admin/products
        end
    end
end

opt Thay đổi trạng thái danh mục
    Admin -> CategoriesPage: Chọn Đang kinh doanh / Ngừng kinh doanh
    CategoriesPage -> Router: POST /admin/categories/status
    Router -> CatalogManagementController: categoryStatus()
    CatalogManagementController -> CatalogManagementController: Kiểm tra CSRF,\nMaDM và trạng thái hợp lệ
    alt Dữ liệu không hợp lệ
        CatalogManagementController --> CategoriesPage: Flash lỗi, redirect /admin/products
    else Dữ liệu hợp lệ
        CatalogManagementController -> Product: changeCategoryStatus(MaDM, trạng thái)
        Product -> DB: UPDATE TrangThai theo MaDM
        DB --> Product: Có cập nhật / không tìm thấy
        alt Cập nhật thành công
            Product --> CatalogManagementController: Thành công
            CatalogManagementController --> CategoriesPage: Flash thành công,\nredirect /admin/categories
        else Cập nhật thất bại
            Product --> CatalogManagementController: Thất bại
            CatalogManagementController --> CategoriesPage: Flash lỗi,\nredirect /admin/products
        end
    end
end

opt Xóa danh mục
    Admin -> CategoriesPage: Yêu cầu xóa danh mục
    CategoriesPage -> Router: POST /admin/categories/delete
    Router -> CatalogManagementController: deleteCategory()
    CatalogManagementController -> CatalogManagementController: Kiểm tra CSRF
    alt CSRF không hợp lệ
        CatalogManagementController --> CategoriesPage: Flash lỗi,\nredirect /admin/products
    else Yêu cầu hợp lệ
        CatalogManagementController -> Product: deleteCategory(MaDM)
        Product -> DB: COUNT sản phẩm đang tham chiếu danh mục
        DB --> Product: Số sản phẩm liên kết
        alt Không còn sản phẩm liên kết
            Product -> DB: DELETE danh mục theo MaDM
            DB --> Product: Xóa thành công / không tìm thấy
            alt Xóa thành công
                Product --> CatalogManagementController: Thành công
                CatalogManagementController --> CategoriesPage: Flash thành công,\nredirect /admin/categories
            else Danh mục không tồn tại
                Product --> CatalogManagementController: Thất bại
                CatalogManagementController --> CategoriesPage: Flash lỗi,\nredirect /admin/products
            end
        else Còn sản phẩm liên kết
            Product --> CatalogManagementController: Từ chối xóa
            CatalogManagementController --> CategoriesPage: Flash lỗi,\nredirect /admin/products; hướng dẫn ngừng kinh doanh
        end
    end
end

note over Admin, DB
  Điều kiện trước: quản trị viên đã đăng nhập.
  Danh mục có sản phẩm liên kết không được xóa vật lý.
  Lỗi thao tác hiện được chuyển hướng về /admin/products.
end note
@enduml
