@startuml
title T&T COMPUTER - ERD tài khoản / địa chỉ / giỏ hàng
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
entity NguoiDung { *MaND : VARCHAR(20) <<PK>>\nHoTen : VARCHAR(100)\nSDT : VARCHAR(15) <<NULL>>\nEmail : VARCHAR(100) <<NULL>>\nDiaChiNhanHang : VARCHAR(255) <<NULL>> }
entity TaiKhoan { *MaTK : VARCHAR(20) <<PK>>\nMaND : VARCHAR(20) <<FK, UQ>>\nTenDangNhap : VARCHAR(50) <<UQ>>\nMatKhau : VARCHAR(255)\nVaiTro : VARCHAR(20)\nTrangThai : VARCHAR(30)\nGoogleID : VARCHAR(255) <<NULL, UQ>> }
entity DiaChiNhanHang { *MaDiaChi : INT UNSIGNED <<PK, AI>>\nMaND : VARCHAR(20) <<FK>>\nDiaChi : VARCHAR(255)\nUQ(MaND,DiaChi) }
entity GioHang { *MaGH : VARCHAR(20) <<PK>>\nMaND : VARCHAR(20) <<FK, UQ>>\nTongTien : DECIMAL(18,2) }
entity ChiTietGioHang { *MaCTGH : VARCHAR(20) <<PK>>\nMaGH : VARCHAR(20) <<FK>>\nMaSP : VARCHAR(20) <<FK>>\nSoLuong : INT\nUQ(MaGH,MaSP) }
entity SanPham { *MaSP : VARCHAR(20) <<PK>> }
NguoiDung ||--o| TaiKhoan
NguoiDung ||--o{ DiaChiNhanHang
NguoiDung ||--o| GioHang
GioHang ||--o{ ChiTietGioHang
SanPham ||--o{ ChiTietGioHang
note bottom: Email không có UNIQUE trong schema. GioHang/ChiTietGioHang lưu theo NguoiDung và sản phẩm.
@enduml
